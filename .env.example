# Public site configuration
NEXT_PUBLIC_SITE_URL=https://byteblast.xyz
NEXT_PUBLIC_GITHUB_USERNAME=gnxbd4vbtm-ops

# Admin access for the private settings page
SETTINGS_ADMIN_EMAIL=admin@byteblast.xyz

# Private settings auth
# Generate a secure scrypt hash and keep the entire string in one line.
SETTINGS_PASSWORD_HASH=scrypt$16384$8$1$CHANGE_ME$CHANGE_ME
SETTINGS_SESSION_SECRET=replace-with-random-long-secret
SETTINGS_RESET_SECRET=replace-with-random-long-secret

# Email config for password reset emails
EMAIL_FROM=noreply@byteblast.xyz
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@byteblast.xyz
SMTP_PASS=replace-with-privateemail-password

# Optional GitHub API fetch token (never expose this to the client)
GITHUB_TOKEN=

# Optional monitoring URL for status page if added later
MONITORING_API_URL=
